diff --git tree/manuskript/tests/load_save/test_final_probes.py tree/manuskript/tests/load_save/test_final_probes.py
new file mode 100644
index 0000000..dcc9bbf
--- /dev/null
+++ tree/manuskript/tests/load_save/test_final_probes.py
@@ -0,0 +1,300 @@
+"""Probes for FINAL-save-design.md (judges' scenarios, adapted to the "-ID" suffix names)."""
+import os
+
+from manuskript import loadSave
+from manuskript.enums import Outline, Character
+from manuskript.load_save import version_1
+from manuskript.tests.load_save.helpers import addItem, drag, tree, relPath
+
+
+def _discardAndReload(MW, monkeypatch):
+    path = MW.currentProject
+    MW.projectDirty = False
+    monkeypatch.setattr(loadSave, "saveProject", lambda *a, **k: False)
+    monkeypatch.setattr(MW, "confirmCloseWithoutSaving", lambda: True, raising=False)
+    MW.closeProject()
+    monkeypatch.undo()
+    MW.loadProject(path)
+    assert MW.currentProject == path
+
+
+def _failWrite(monkeypatch, paths):
+    realWrite = version_1.writeFile
+    paths = [os.path.realpath(p) for p in paths]
+
+    def failingWrite(filename, content, *args, **kwargs):
+        if os.path.realpath(filename) in paths:
+            raise PermissionError(13, "Permission denied (in use by another program)", filename)
+        return realWrite(filename, content, *args, **kwargs)
+
+    monkeypatch.setattr(version_1, "writeFile", failingWrite)
+
+
+def _texts(MW):
+    return sorted(t[4] for t in tree(MW) if t[3] == "md")
+
+
+def test_same_slug_names_have_id(emptyProject):
+    MW = emptyProject
+    chapter = addItem(MW, MW.mdlOutline.rootItem, "Kapitel", folder=True)
+    a = addItem(MW, chapter, "Grüße", "A")
+    b = addItem(MW, chapter, "Größe", "B")
+    c = addItem(MW, chapter, "Später", "C")
+    names = [os.path.basename(relPath(i)) for i in (a, b, c)]
+    assert names == ["0-Gr--e-%s.md" % a.ID(), "1-Gr--e-%s.md" % b.ID(), "2-Sp-ter.md"]
+    # linear paths == outlineItemPath
+    files = version_1.exportOutlineItem(MW.mdlOutline.rootItem)
+    assert sorted(p for p, c_, o in files) == sorted(
+        [os.path.join(relPath(chapter), "folder.txt")] + [relPath(i) for i in (a, b, c)])
+
+
+def test_swap_same_slug_failed_write(emptyProject, monkeypatch):
+    MW = emptyProject
+    chapter = addItem(MW, MW.mdlOutline.rootItem, "Kapitel", folder=True)
+    for title in ["Grüße", "Größe"]:
+        addItem(MW, chapter, title, "Text of " + title)
+    assert loadSave.saveProject()
+    drag(MW, chapter.child(1), chapter, 0)          # Größe, Grüße
+    folder = MW.currentProject[:-4]
+    _failWrite(monkeypatch, [os.path.join(folder, relPath(chapter.child(1)))])
+    assert not loadSave.saveProject()
+    monkeypatch.undo()
+    _discardAndReload(MW, monkeypatch)
+    assert "Text of Grüße" in _texts(MW) and "Text of Größe" in _texts(MW)
+
+
+def test_chain_same_slug_failed_write(emptyProject, monkeypatch):
+    MW = emptyProject
+    chapter = addItem(MW, MW.mdlOutline.rootItem, "Kapitel", folder=True)
+    for title in ["Grüße", "Größe", "Später"]:
+        addItem(MW, chapter, title, "Text of " + title)
+    assert loadSave.saveProject()
+    drag(MW, chapter.child(2), chapter, 0)
+    folder = MW.currentProject[:-4]
+    _failWrite(monkeypatch, [os.path.join(folder, relPath(chapter.child(2)))])
+    assert not loadSave.saveProject()
+    monkeypatch.undo()
+    _discardAndReload(MW, monkeypatch)
+    assert {"Text of Grüße", "Text of Größe", "Text of Später"} <= set(_texts(MW))
+
+
+def test_cross_folder_cycle_is_refused_and_lossless(emptyProject, monkeypatch):
+    """Two lone same-slug scenes at the same row of two folders swap folders: a pure
+    cycle. Neither is written; nothing is lost; renaming one of them resolves it."""
+    MW = emptyProject
+    root = MW.mdlOutline.rootItem
+    f1 = addItem(MW, root, "Eins", folder=True)
+    f2 = addItem(MW, root, "Zwei", folder=True)
+    addItem(MW, f1, "Grüße", "A")
+    addItem(MW, f2, "Größe", "B")
+    assert loadSave.saveProject()
+    a, b = f1.child(0), f2.child(0)
+    drag(MW, a, f2, 0)
+    drag(MW, f2.child(1), f1, 0)
+    assert [c.title() for c in f1.children()] == ["Größe"]
+    assert [c.title() for c in f2.children()] == ["Grüße"]
+    r = loadSave.saveProject()
+    assert not r and any("same file name" in reason for p, reason in r.failed)
+    # discard: both texts still there
+    folder = MW.currentProject[:-4]
+    MW.mdlOutline.setData(f1.child(0).index(Outline.title), "Größe 2")
+    assert loadSave.saveProject()
+    _discardAndReload(MW, monkeypatch)
+    assert sorted(_texts(MW)) == ["A", "B"]
+
+
+def test_duplicate_character_ids_rename_failed_write(sampleProject, monkeypatch):
+    MW = sampleProject
+    folder = MW.currentProject[:-4]
+    chars = os.path.join(folder, "characters")
+    new = max(int(c.ID()) for c in MW.mdlCharacter.characters) + 1
+    for name in ["Anna", "Bert"]:
+        with open(os.path.join(chars, "%d-%s.txt" % (new, name)), "w", encoding="utf8") as f:
+            f.write("Name:                %s\nID:                  %d\n"
+                    "Notes:               Notes of %s\n" % (name, new, name))
+    path = MW.currentProject
+    MW.closeProject()
+    MW.loadProject(path)
+    named = {c.name(): c for c in MW.mdlCharacter.characters}
+    assert named["Anna"].ID() != named["Bert"].ID()
+    assert loadSave.saveProject()
+    MW.mdlCharacter.setData(named["Anna"].index(Character.name), "Anne")
+    _failWrite(monkeypatch, [os.path.join(chars, "%s-Anne.txt" % named["Anna"].ID())])
+    assert not loadSave.saveProject()
+    monkeypatch.undo()
+    _discardAndReload(MW, monkeypatch)
+    notes = sorted(str(c._data.get(Character.notes.value, "")) for c in MW.mdlCharacter.characters)
+    assert "Notes of Anna" in notes and "Notes of Bert" in notes
+
+
+def test_pulled_scene_in_deleted_chapter_stays_loadable(sampleProject):
+    MW = sampleProject
+    folder = MW.currentProject[:-4]
+    part = MW.mdlOutline.rootItem.child(0)
+    chapter = part.child(1)
+    chapterDir = os.path.join(folder, relPath(chapter))
+    pulled = os.path.join(chapterDir, "9-Pulled_scene.md")
+    with open(pulled, "w", encoding="utf8") as f:
+        f.write("title:          Pulled scene\nID:             9000\ntype:           md\n\n\n"
+                "Written on the other machine.\n")
+    MW.mdlOutline.removeIndex(chapter.index())
+    r = loadSave.saveProject()
+    path = MW.currentProject
+    MW.projectDirty = False
+    MW.closeProject()
+    MW.loadProject(path)
+    texts = [t[4] for t in tree(MW)]
+    assert any("Written on the other machine." in (t or "") for t in texts) or not r
+
+
+def test_failed_new_folder_txt_writes_nothing_below_it(sampleProject, monkeypatch):
+    """No orphans: when the folder.txt of a renamed chapter cannot be written, none of its
+    scenes are written at the new place (they would not be loaded)."""
+    MW = sampleProject
+    folder = MW.currentProject[:-4]
+    chapter = MW.mdlOutline.rootItem.child(0).child(1)
+    MW.mdlOutline.setData(chapter.index(Outline.title), "Pentecost")
+    newDir = os.path.join(folder, relPath(chapter))
+    _failWrite(monkeypatch, [os.path.join(newDir, "folder.txt")])
+    r = loadSave.saveProject()
+    monkeypatch.undo()
+    assert not r
+    assert not os.path.exists(newDir) or os.listdir(newDir) == []
+    MW.projectDirty = False
+
+
+def test_crlf_checkout_is_not_rewritten_nor_a_conflict(sampleProject):
+    MW = sampleProject
+    folder = MW.currentProject[:-4]
+    scene = MW.mdlOutline.rootItem.child(0).child(0).child(0)
+    f = os.path.join(folder, relPath(scene))
+    with open(f, "rb") as fo:
+        data = fo.read()
+    with open(f, "wb") as fo:
+        fo.write(data.replace(b"\n", b"\r\n"))
+    mtime = os.stat(f).st_mtime_ns
+    assert loadSave.saveProject()
+    assert os.stat(f).st_mtime_ns == mtime     # not rewritten
+    MW.mdlOutline.setData(scene.index(Outline.text), "edited")
+    assert loadSave.saveProject()              # no conflict: same content as recorded
+    with open(f, "rb") as fo:
+        assert b"\r\n" not in fo.read()
+
+
+def test_external_change_is_a_conflict(sampleProject):
+    MW = sampleProject
+    folder = MW.currentProject[:-4]
+    scene = MW.mdlOutline.rootItem.child(0).child(0).child(0)
+    f = os.path.join(folder, relPath(scene))
+    with open(f, "a", encoding="utf8") as fo:
+        fo.write("pulled\n")
+    MW.mdlOutline.setData(scene.index(Outline.text), "edited")
+    r = loadSave.saveProject()
+    assert not r and r.conflicts
+    with open(f, encoding="utf8") as fo:
+        assert fo.read().endswith("pulled\n")
+    MW.projectDirty = False
+
+
+def test_noop_save_writes_nothing(sampleProject):
+    MW = sampleProject
+    folder = MW.currentProject[:-4]
+    before = {}
+    for d, ds, fs in os.walk(folder):
+        for n in fs:
+            before[os.path.join(d, n)] = os.stat(os.path.join(d, n)).st_mtime_ns
+    assert loadSave.saveProject()
+    path = MW.currentProject
+    MW.closeProject()
+    MW.loadProject(path)
+    assert loadSave.saveProject()
+    after = {}
+    for d, ds, fs in os.walk(folder):
+        for n in fs:
+            after[os.path.join(d, n)] = os.stat(os.path.join(d, n)).st_mtime_ns
+    assert after == before
+
+
+def test_loadable_files_matches_loader(sampleProject):
+    MW = sampleProject
+    folder = MW.currentProject[:-4]
+    extra = {
+        "outline/0-Jerusalem/0-Chapter_1/9-my_new_scene.md": "title: x\ntype: md\n\n\nno id\n",
+        "outline/0-Jerusalem/9-Lost_chapter/0-scene.md": "title: y\nID: 900\ntype: md\n\n\nz\n",
+        "characters/notes.txt": "Name: Notes\n",
+    }
+    for f, content in extra.items():
+        f = os.path.join(folder, *f.split("/"))
+        os.makedirs(os.path.dirname(f), exist_ok=True)
+        with open(f, "w", encoding="utf8") as fo:
+            fo.write(content)
+    path = MW.currentProject
+    MW.closeProject()
+    MW.loadProject(path)
+    texts = {}
+    for d, ds, fs in os.walk(folder):
+        rel = os.path.relpath(d, folder)
+        rel = "" if rel == "." else rel
+        for n in fs:
+            p = os.path.join(rel, n)
+            if n[:1] == "." or (not rel and n not in version_1.projectFiles):
+                continue
+            with open(os.path.join(d, n), "rb") as fo:
+                raw = fo.read()
+            texts[p] = raw if n[-4:] in (".xml", "opml") else raw.decode("utf8")
+    assert version_1.loadableFiles(texts) == set(version_1.store.owned)
+
+
+def test_save_as_onto_older_project_with_character_without_id(sampleProject, tmp_path):
+    """judge-effort probe: an ID-less character file of an older project must not be
+    loaded into the new project after "Save as" onto it."""
+    MW = sampleProject
+    target = os.path.join(str(tmp_path), "older")
+    os.makedirs(os.path.join(target, "characters"))
+    with open(os.path.join(target, "MANUSKRIPT"), "w") as f:
+        f.write("1")
+    with open(os.path.join(target, "characters", "9-Ghost.txt"), "w") as f:
+        f.write("Name: Ghost of the older project\n")
+    names = sorted(c.name() for c in MW.mdlCharacter.characters)
+    assert MW.saveDatas(target + ".msk")
+    MW.closeProject()
+    MW.loadProject(target + ".msk")
+    after = sorted(c.name() for c in MW.mdlCharacter.characters)
+    MW.closeProject()
+    assert after == names
+
+
+def test_case_variant_stems_get_id(emptyProject):
+    """Stems are compared ignoring case: on a case-insensitive file system, swapping
+    'Intro' and 'intro' would otherwise be a cycle (and is refused)."""
+    MW = emptyProject
+    chapter = addItem(MW, MW.mdlOutline.rootItem, "Kapitel", folder=True)
+    a = addItem(MW, chapter, "Intro", "A")
+    b = addItem(MW, chapter, "intro", "B")
+    names = [os.path.basename(relPath(i)) for i in (a, b)]
+    assert names == ["0-Intro-%s.md" % a.ID(), "1-intro-%s.md" % b.ID()]
+    files = version_1.exportOutlineItem(MW.mdlOutline.rootItem)
+    assert sorted(p for p, c_, o in files) == sorted(
+        [os.path.join(relPath(chapter), "folder.txt")] + [relPath(i) for i in (a, b)])
+
+
+def test_normal_save_into_replaced_folder_is_a_conflict(sampleProject):
+    """The project folder is replaced on disk while open (moved away, cloned again, one scene
+    changed there). A normal save must compare with the store of the open project: conflict,
+    nothing overwritten. It must not treat the folder as an 'older project'."""
+    import shutil
+    MW = sampleProject
+    folder = MW.currentProject[:-4]
+    assert loadSave.saveProject()
+    shutil.move(folder, folder + "-bak")
+    shutil.copytree(folder + "-bak", folder)
+    scene = next(os.path.join(d, f) for d, dn, fn in sorted(os.walk(os.path.join(folder, "outline")))
+                 for f in sorted(fn) if f.endswith(".md"))
+    with open(scene, "a", encoding="utf8") as f:
+        f.write("\nWritten on the other computer.\n")
+    MW.mdlFlatData.item(0, 0).setText("A new title")
+    r = loadSave.saveProject()
+    assert not r and any(p == os.path.relpath(scene, folder) for p, k in r.conflicts)
+    with open(scene, encoding="utf8") as f:
+        assert f.read().endswith("Written on the other computer.\n")
